    },
    "fallbackPhrase": "Keep flying!",
    "_id": "dcBi38LrBBULXMkReN5v0z"
  },
  {
    "__type__": "GameOverPhraseTier",
    "minMeters": 0,
    "phrases": [
      "Your flight was brief, but history noticed. For several minutes.",
      "Rome has seen worse pigeons. Probably.",
      "The Senate has declined to comment.",
      "Your legend is still under construction.",
      "You flew like a true Roman tax collector: carefully and not very far.",
      "Future generations may hear of you. If they ask nobody.",
      "Even the statues looked away.",
      "A respectable attempt. Respectable enough to remain anonymous.",
      "You almost became famous. Then you landed.",
      "The Empire remains unconcerned."
    ]
  },
  {
    "__type__": "GameOverPhraseTier",
    "minMeters": 1000,
    "phrases": [
      "Citizens have begun discussing your flight. Mostly by accident.",
      "Your name echoes through the streets of Rome. One street, at least.",
      "A decent performance worthy of a modest marble plaque.",
      "The Senate has finally noticed you. They remain confused.",
      "Your pigeon instincts are becoming legendary.",
      "Merchants tell tales of your journey between sales.",
      "You flew far enough to earn a dramatic retelling.",
      "Children pretend to be you in the forums.",
      "Rome approves. Rome rarely approves anything.",
      "A promising career in aerial greatness awaits."
    ]
  },
  {
    "__type__": "GameOverPhraseTier",
    "minMeters": 2000,
    "phrases": [
      "A promising career in aerial greatness awaits.",
      "Your wings have carried you straight into legend.",
      "The Senate rises in applause. Mostly out of fear.",
      "Statues will be built in your honor. Pigeon-sized, but still.",
      "Your flight has become the gold standard of pigeon excellence.",
      "Generals study your route for military inspiration.",
      "The Empire may survive for centuries on this achievement alone.",
      "Caesar wishes he had your wings.",
      "Your legend now requires its own aqueduct.",
      "Rome wasn't built in a day. Your reputation was."
    ]
  },
