// Полупрозрачный тинт поверх оригинала: mix(текстура, цвет, сила). Альфа силуэта сохраняется.
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        tintColor: { value: [1.0, 0.0, 0.0, 0.5], editor: { type: color, displayName: Tint Color } }
        tintStrength: { value: 0.5, editor: { slide: true, range: [0, 1], step: 0.01, displayName: Tint Strength } }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out mediump vec2 v_uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    v_uv0 = a_texCoord;
    v_color = a_color;
    return pos;
  }
}%

CCProgram fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in mediump vec2 v_uv0;
  in vec4 v_color;

  uniform Constant {
    vec4 tintColor;
    float tintStrength;
  };

  #pragma builtin(local)
  layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;

  vec4 frag () {
    vec4 tex = CCSampleWithAlphaSeparated(cc_spriteTexture, v_uv0);
    float blend = clamp(tintColor.a * tintStrength, 0.0, 1.0);
    vec3 rgb = mix(tex.rgb, tintColor.rgb, blend);
    float alpha = tex.a * v_color.a;
    vec4 o = vec4(rgb, alpha);
    ALPHA_TEST(o);
    return o;
  }
}%
